{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "required_changes", "questions", "approval_conditions"],
  "properties": {
    "status": {"type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["severity", "path", "issue", "recommendation"], "properties": {"severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]}, "path": {"type": "string", "minLength": 1}, "issue": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}}},
    "required_changes": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "approval_conditions": {"type": "array", "items": {"type": "string"}}
  }
}
