# Copy this file to .env.deploy and adjust it for the remote host. It is merged
# with .env during deployment; values here override values from .env.
DEPLOY_REMOTE_DIR=/opt/antler-rag

# Public port on the remote host. The application listens on container port 8000.
RAG_WEB_PORT=8000

# Name of the Docker volume that holds SQLite, Chroma, and uploaded files.
# Keep it unchanged when upgrading an existing deployment.
RAG_DATA_VOLUME=antler-rag-data
