# Required only for first-time initialization. Remove these after the first successful start.
RAG_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RAG_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# The single persistent volume is mounted here in production.
# Local development path. compose.yaml overrides this to /data inside the container.
RAG_DATA_DIR=data
RAG_ENVIRONMENT=development
RAG_SESSION_HOURS=12
RAG_MAX_UPLOAD_BYTES=26214400
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_CHAT_MODEL=
RAG_EMBEDDING_MODEL=
# Optional. DashScope text-embedding-v4 supports 64 through 2048 dimensions.
RAG_EMBEDDING_DIMENSIONS=1024
# Optional Hugging Face Text Embeddings Inference endpoint serving a CrossEncoder,
# e.g. BAAI/bge-reranker-large. Leave empty to keep reranking unavailable.
RAG_RERANKER_BASE_URL=
RAG_RERANKER_API_KEY=
