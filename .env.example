# Required only for first-time initialization. Remove these after the first successful start.
RAG_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RAG_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# The single persistent volume is mounted here in production.
RAG_DATA_DIR=/data
RAG_ENVIRONMENT=development
RAG_SESSION_HOURS=12
RAG_MAX_UPLOAD_BYTES=26214400
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
